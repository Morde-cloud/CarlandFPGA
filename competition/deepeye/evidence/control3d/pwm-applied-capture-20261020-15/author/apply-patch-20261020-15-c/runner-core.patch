+    manifest["runner"]["snapshot_name"] = runner_snapshot.name
+    manifest["runner"]["sha256"] = sha256_file(runner_snapshot)
+    manifest["runner"]["bytes"] = runner_snapshot.stat().st_size
+    return manifest
