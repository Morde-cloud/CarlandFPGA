+ logic [1:0] channel;logic [47:0] data;
+ logic [191:0] qpcs;logic [23:0] qualities;
+ logic [95:0] firsts,lasts;logic [31:0] tag,first_index;
+ logic [62:0] origin;logic [63:0] stride_ns;logic [15:0] stride_us;
