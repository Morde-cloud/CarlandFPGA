diff --git a/competition/deepeye/fpga/diagnostic/offboard_aggregate77/tb_SYNTHETIC_aggregate77.sv b/competition/deepeye/fpga/diagnostic/offboard_aggregate77/tb_SYNTHETIC_aggregate77.sv
