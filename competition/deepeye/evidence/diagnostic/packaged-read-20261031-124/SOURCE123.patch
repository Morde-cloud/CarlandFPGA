+proc f50_read_source_bytes {path context} {
+    # Capture the actual call boundary before reading. Metadata is diagnostic,
+    # never a substitute for opening/reading or the exact-byte checks below.
+    set intent [dict create context $context path $path]
+    foreach property {exists isfile readable size} {
+        set code [catch [list file $property $path] value]
+        dict set intent file_$property [list $code $value]
+    }
+    puts [list F50_SOURCE_READ_BEGIN $intent]
+    flush stdout
+    set channel ""
+    set step open
+    if {[catch {
+        set channel [open $path rb]
+        set step read
+        set data [read $channel]
+        set step close
+        close $channel
+        set channel ""
+    } message options]} {
+        # Retain the original error even when the vendor returns an empty
+        # message. Cleanup never reopens or retries the failed read.
+        catch {
+            puts stderr [list F50_SOURCE_READ_ERROR $context $path $step $message $options]
+            flush stderr
+        }
+        if {$channel ne "" && $step eq "read"} {catch {close $channel}}
+        return -options $options $message
+    }
+    puts [list F50_SOURCE_READ_END $context $path [string length $data]]
+    flush stdout
+    return $data
+}
