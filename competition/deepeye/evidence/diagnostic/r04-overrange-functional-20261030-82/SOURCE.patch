+      "expected": [
+        "master_cancel is asserted; the 76 master returns its digital terminal/error for tagS.",
+        "The wrapper stores the safety result with tagS and error, clears safety in-flight, and performs no automatic retry.",
+        "inhibit remains 1, armed remains 0, and host_ready remains 0 until slots are drained and a new explicit safe arm occurs."
+      ],
+      "not_proven": "A failed fallback is not converted to success and its analog effect is unknown."
+    },
+    {
+      "id": "V18_CANCEL_DROPS_UNSENT_FALLBACK",
+      "focus": "no replay of pending safety request",
+      "stimulus": [
+        "Overrange latches while a host result slot is held and the master is temporarily not ready, so fallback is pending but not yet sent.",
+        "Assert cancel before m_cmd_ready becomes 1, then deassert cancel and hold enable=1 without a new arm pulse."
+      ],
+      "expected": [
+        "fallback_pending is cleared on cancel; no safety command is sent after cancel deasserts.",
+        "inhibit remains 1 and armed remains 0.",
+        "A later explicit arm is required after overrange is low and both slots are drained; the dropped fallback is not automatically retried."
+      ],
+      "not_proven": "This records a conservative unfulfilled fallback behavior, not a safety-complete product."
