+        "Arm safely and open host_gate, then drive overrange=1 in the same cycle as host_valid=1 with tagA/gain4.",
+        "Keep overrange high after the edge."
+      ],
+      "expected": [
+        "host_ready is 0 in that cycle because the combinational host path includes !overrange; no host handshake occurs.",
+        "inhibit becomes 1 at the edge and fallback becomes pending for the safety owner.",
+        "No host result is created for the blocked attempt; the fallback gain0 command can be sent only after the 76 master is ready."
+      ],
+      "not_proven": "No threshold, ADC sample, or calibration source is modeled."
+    },
+    {
+      "id": "V11_HOST_INFLIGHT_OVERRANGE_CANCEL_AND_DRAIN",
+      "focus": "host in-flight cancellation",
+      "stimulus": [
