+      "not_proven": "A forced tag mismatch is an interface fault; no claim is made about the real device's tag generation."
+    },
+    {
+      "id": "V20_UNSOLICITED_MASTER_RESULT",
+      "focus": "no owner identity",
+      "stimulus": [
+        "With no host or safety transaction in flight, force master result_valid=1 with any tag."
+      ],
+      "expected": [
+        "sticky_fault=1, inhibit=1, armed=0; no result is accepted or stored.",
+        "No fallback or host command is issued while faulted."
+      ],
+      "not_proven": "No protocol recovery is implemented."
+    },
+    {
+      "id": "V21_ZERO_SAFETY_TAG_BLOCKS_ARM",
+      "focus": "missing reserved identity",
+      "stimulus": [
+        "From reset with overrange=0, empty slots, and master ready, pulse arm while reserved_safety_tag=0."
+      ],
+      "expected": [
+        "The arm is refused; sticky_fault=1 and inhibit=1, armed=0 and host_gate=0.",
+        "No host or safety command can start; production integration remains disabled until a distinct nonzero reserved tag is supplied and reset/recovery is separately reviewed."
+      ],
+      "not_proven": "No legal reserved tag has been assigned by the product/protocol owner; this is a documented blocker."
+    },
+    {
+      "id": "V22_SAFETY_TAG_CHANGE_AFTER_ARM",
+      "focus": "identity stability",
+      "stimulus": [
+        "Arm with tagS latched, then change reserved_safety_tag to tagC before any overrange or host handshake."
+      ],
+      "expected": [
+        "The next clk edge raises sticky_fault and inhibit; armed is cleared and host_ready is 0.",
+        "No fallback with the changed or old identity is started after the fault."
+      ],
+      "not_proven": "The input is expected to be static by contract; no dynamic reconfiguration protocol is defined."
+    },
+    {
+      "id": "V23_BOTH_FIXED_SLOTS_NO_OVERWRITE",
+      "focus": "two-slot independence",
+      "stimulus": [
+        "Hold a host result tagA in its slot and trigger fallback while the host slot remains full; allow the safety result tagS to complete.",
+        "Keep both result_ready inputs low for many cycles."
+      ],
+      "expected": [
+        "Both valid bits are 1 simultaneously; host payload remains tagA and safety payload remains tagS.",
+        "No queue growth, eviction, or cross-slot overwrite occurs.",
+        "Each slot clears only with its own valid && ready handshake."
+      ],
+      "not_proven": "No throughput or timing closure claim is made."
+    },
+    {
+      "id": "V24_RESET_MIDFLIGHT_NO_ACK",
+      "focus": "destructive reset",
+      "stimulus": [
