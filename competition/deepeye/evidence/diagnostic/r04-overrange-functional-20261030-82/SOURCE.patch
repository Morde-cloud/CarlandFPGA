+      ],
+      "not_proven": "This does not prove analog recovery or an ADC overrange threshold."
+    },
+    {
+      "id": "V13_SUSTAINED_OVERRANGE_NO_DUPLICATE_FALLBACK",
+      "focus": "single fallback per episode",
+      "stimulus": [
+        "After V11 or V12 has issued fallback and stored its safety result, hold overrange=1 for many cycles with both slots held.",
+        "Toggle unrelated host controls while the safety tag remains valid."
