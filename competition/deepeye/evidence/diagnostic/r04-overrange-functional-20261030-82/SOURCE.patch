+      "not_proven": "Explicit arm is an external operator/controller action and is not validated as a human safety authorization."
+    },
+    {
+      "id": "V16_CANCEL_HOST_INFLIGHT",
+      "focus": "cancel boundary",
+      "stimulus": [
+        "With no overrange, accept host tagA mid-frame, then assert cancel=1 for one or more cycles.",
+        "Deassert cancel while keeping enable=1."
