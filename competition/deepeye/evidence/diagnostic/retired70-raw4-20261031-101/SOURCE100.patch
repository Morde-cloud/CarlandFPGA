+        if type(v) is float: a._need(math.isfinite(v), 'private finite float')
+        if type(v) is dict:
+            for k,x in v.items(): a._need(type(k) is str, 'private key'); plain(x,depth+1)
+        if type(v) is list:
+            a._need(len(v) <= 128, 'private array bound')
+            for x in v: plain(x,depth+1)
+    plain(value)
+    return value
+
+def project(raw):
+    v = read_original(raw)
