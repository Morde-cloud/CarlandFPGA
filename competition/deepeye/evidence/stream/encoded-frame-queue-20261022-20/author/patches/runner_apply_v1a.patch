+def run_process(
+    argv: list[str], cwd: Path, step_dir: Path, timeout_s: int
+) -> dict:
+    step_dir.mkdir(parents=False, exist_ok=False)
+    started_at = utc_now()
+    write_json(
+        step_dir / "command.json",
+        {
+            "argv": [str(item) for item in argv],
+            "cwd": str(cwd),
+            "timeout_s": timeout_s,
+            "started_at": started_at,
+        },
+    )
+    stdout_path = step_dir / "stdout.txt"
+    stderr_path = step_dir / "stderr.txt"
+    stdout_path.write_bytes(b"")
+    stderr_path.write_bytes(b"")
+    start = time.monotonic()
+    returncode = None
+    timed_out = False
+    spawn_error = None
+    try:
+        with stdout_path.open("wb") as stdout_handle, stderr_path.open(
+            "wb"
+        ) as stderr_handle:
+            try:
+                process = subprocess.Popen(
+                    [str(item) for item in argv],
+                    cwd=str(cwd),
+                    stdout=stdout_handle,
+                    stderr=stderr_handle,
+                    shell=False,
+                )
+            except OSError as exc:
+                spawn_error = f"{type(exc).__name__}: {exc}"
+            else:
+                try:
+                    returncode = process.wait(timeout=timeout_s)
+                except subprocess.TimeoutExpired:
+                    timed_out = True
+                    process.kill()
+                    try:
+                        returncode = process.wait(timeout=10)
+                    except subprocess.TimeoutExpired:
+                        returncode = None
+    except OSError as exc:
+        spawn_error = f"{type(exc).__name__}: {exc}"
+    duration_s = round(time.monotonic() - start, 3)
+    record = {
+        "argv": [str(item) for item in argv],
+        "cwd": str(cwd),
+        "started_at": started_at,
+        "finished_at": utc_now(),
+        "duration_s": duration_s,
+        "timeout_s": timeout_s,
+        "timed_out": timed_out,
+        "returncode": returncode,
+        "spawn_error": spawn_error,
+    }
+    write_json(step_dir / "process.json", record)
+    return record
+
