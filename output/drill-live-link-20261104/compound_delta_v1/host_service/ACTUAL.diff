+    def test_new_real_round_after_expired_lease_observes_off_then_arms(self):
+        s=self.attach();self.delta(s);self.clock.now+=.301
+        # Model the actual MCU watchdog result; cached reply remains armed.
+        self.root.mmio.armed=False;self.root.mmio.norm=self.root.mmio.duty=0
+        self.root.mmio.result=7  # Real MTR5 STATUS preserves WATCHDOG until ARM.
